# TC Hostel Connect - Environment Configuration
# 
# For DEVELOPMENT: Copy this file to .env (local development)
# For PRODUCTION: See .env.production.example and use secrets management
# For DOCKER: See .env.docker for containerized setup

# ===========================================
# BACKEND SERVER CONFIGURATION
# ===========================================
# PORT: Server port (default: 3001)
# NODE_ENV: Environment mode (development|production|test)
# Default: development for local, production for deployed
PORT=3001
NODE_ENV=development

# JWT_SECRET: Secret key for signing JWTs
# DEVELOPMENT: Any value of 32+ chars works
# PRODUCTION: Must be strong, random, and unique - use: openssl rand -base64 32
JWT_SECRET=dev-secret-key-min-32-chars-long-change-in-production

# CORS Configuration - Comma-separated list of allowed origins
# DEVELOPMENT: http://localhost:* allowed
# PRODUCTION: Only your domain - NO localhost
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001

# Logging Configuration
# Levels: trace, debug, info, warn, error, fatal
# DEVELOPMENT: debug (verbose)
# PRODUCTION: info or warn (less noise)
LOG_LEVEL=debug

# ===========================================
# SUPABASE CONFIGURATION
# ===========================================
# Register at: https://supabase.com
# Create project, then get credentials from Settings > API
# These are REQUIRED for the backend to function

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Frontend Supabase Configuration
# Use public anon key for browser client (safe)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================
VITE_APP_NAME=TC Hostel Connect
VITE_APP_VERSION=1.0.0
VITE_APP_ENVIRONMENT=development

# ===========================================
# DEVELOPMENT CONFIGURATION
# ===========================================
# Debug and devtools - NEVER enable in production
VITE_DEBUG_MODE=true
VITE_LOG_LEVEL=info
VITE_ENABLE_DEVTOOLS=true

# ===========================================
# GETTING STARTED
# ===========================================
# 1. Update SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY
# 2. Run: npm run dev (frontend) or cd backend && npm run dev (backend)
# 3. Access: http://localhost:5173 (frontend)
# 4. API Docs: http://localhost:3001/api-docs
# 5. Health Check: http://localhost:3001/api/health

# For full setup with Docker: docker-compose up
# See DEPLOYMENT.md for detailed instructions
# INSTRUCTIONS FOR SUPABASE RE-ENABLEMENT
# ===========================================
# 1. Create a Supabase project at https://supabase.com
# 2. Get your project URL and anon key from Settings > API
# 3. Uncomment the VITE_SUPABASE_* variables above
# 4. Set VITE_MOCK_MODE=false
# 5. Update src/lib/supabase.ts to use real Supabase client
# 6. Run database migrations in supabase/migrations/
# 7. Restart your development server

# ===========================================
# SECURITY NOTES
# ===========================================
# - Never commit your .env file to version control
# - Keep your Supabase keys secure
# - Use different keys for development and production
# - Regularly rotate your API keys