{
  "name": "hostel-connect-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm run dev --workspace=@hostel-connect/web",
    "dev:api": "npm run dev --workspace=@hostel-connect/api",
    "dev:control-center": "npm run dev --workspace=@hostel-connect/control-center",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace=@hostel-connect/web",
    "build:api": "npm run build --workspace=@hostel-connect/api",
    "build:control-center": "npm run build --workspace=@hostel-connect/control-center",
    "type-check": "tsc -b",
    "lint": "eslint .",
    "test": "npm run test --workspace=@hostel-connect/web",
    "test:api": "npm run test:api --workspace=@hostel-connect/api",
    "test:e2e": "playwright test",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ui": "playwright test --ui",
    "test:load": "k6 run tests/load/load-test.js",
    "test:load:quick": "k6 run --vus 10 --duration 1m tests/load/load-test.js",
    "test:all": "npm test && npm run test:api && npm run test:e2e",
    "cap:sync": "npm run cap:sync --workspace=@hostel-connect/mobile-android",
    "cap:open": "npm run cap:open --workspace=@hostel-connect/mobile-android"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@playwright/test": "^1.58.2",
    "concurrently": "^8.2.2",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "turbo": "^2.4.4",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0"
  }
}
