# Services/API - Environment Template
PORT=3001
NODE_ENV=development
JWT_SECRET=dev-secret-key-min-32-chars-long-change-in-production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001
LOG_LEVEL=debug

# Supabase (Optional if using local SQLite)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_SECRET_KEY is the server-only secret. Keep it out of source control.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
FROM_EMAIL=noreply@tchostel.com

# Never commit real credentials or app passwords to this repository.
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
